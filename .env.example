# ==============================================================================
# PhantomNet V3 - Production Environment Configuration Template
# Generate cryptographic secrets using: python -c "import secrets; print(secrets.token_hex(32))"
# ==============================================================================

# Database Configuration
# Local dev: sqlite:///backend/phantomnet.db
# Production PostgreSQL:
DATABASE_URL=postgresql://phantomnet_user:REPLACE_WITH_STRONG_DB_PASSWORD@postgres:5432/phantomnet
DB_HOST=postgres
DB_PORT=5432
POSTGRES_USER=phantomnet_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=phantomnet

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False
API_LOG_LEVEL=INFO

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000
REACT_APP_ENV=development

# Security & Secrets (MANDATORY IN PRODUCTION: min 32 chars, must not use default)
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_HEX_64_CHARS_GENERATED_BY_SECRETS_MODULE
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# Honeypot Producer Origin Authentication (HMAC-SHA256)
HONEYPOT_SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_HEX_64_CHARS_FOR_HONEYPOT_ORIGIN_SIGNING

# Internal Management API Key (For headless automation / CI)
API_KEY=REPLACE_WITH_SECURE_MANAGEMENT_API_KEY

# Honeypot Ports
SSH_HONEYPOT_PORT=2222
HTTP_HONEYPOT_PORT=8080
FTP_HONEYPOT_PORT=2121
SMTP_HONEYPOT_PORT=2525

# Threat Intelligence API Keys (Register at abuseipdb.com and otx.alienvault.com)
ABUSE_IPDB_KEY=your_abuseipdb_api_key_here
ALIENVAULT_OTX_KEY=your_alienvault_otx_key_here

# Environment & Localization
ENVIRONMENT=development
TIMEZONE=UTC
PYTHONIOENCODING=utf-8

# Sentinel Playbook Generation Loop (opt-in)
SENTINEL_ENABLED=false
SENTINEL_AUTO_GEN_ENABLED=false
SENTINEL_AUTO_GEN_INTERVAL_MINUTES=30

# Sentinel LLM Configuration (opt-in)
# LLM is isolated to non-critical advisory summaries only (never on detection/blocking path)
SENTINEL_LLM_ENABLED=false
SENTINEL_LLM_HOST=http://ollama:11434
SENTINEL_LLM_MODEL=mistral

# Sentinel Email Alert Notifications (opt-in)
SENTINEL_EMAIL_ALERTS_ENABLED=false
SENTINEL_EMAIL_SMTP_HOST=smtp.gmail.com
SENTINEL_EMAIL_SMTP_PORT=587
SENTINEL_EMAIL_SMTP_USER=your-email@gmail.com
SENTINEL_EMAIL_SMTP_PASSWORD=your-app-password
SENTINEL_EMAIL_SMTP_USE_TLS=true
SENTINEL_EMAIL_FROM_ADDRESS=sentinel@phantomnet.local
SENTINEL_EMAIL_RECIPIENTS=admin@example.com
SENTINEL_EMAIL_SEVERITY_THRESHOLD=CRITICAL
SENTINEL_DASHBOARD_BASE_URL=http://localhost:3000
